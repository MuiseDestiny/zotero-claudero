{
  "name": "claudero",
  "type": "module",
  "version": "0.1.0",
  "description": "AI research assistant embedded in Zotero",
  "config": {
    "addonName": "Claudero",
    "addonID": "claudero@muisedestiny.com",
    "addonRef": "claudero",
    "addonInstance": "Claudero",
    "prefsPrefix": "extensions.zotero.claudero"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MuiseDestiny/zotero-claudero.git"
  },
  "author": "muisedestiny",
  "bugs": {
    "url": "https://github.com/MuiseDestiny/zotero-claudero/issues"
  },
  "homepage": "https://github.com/MuiseDestiny/zotero-claudero#readme",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "zotero-plugin serve",
    "restart": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "check:release": "npm run build && node scripts/verify-release.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "audit:all": "npm audit --audit-level=high",
    "test:helper": "npm run build && node scripts/smoke-helper-communication.mjs --full",
    "test:helper:quick": "npm run build && node scripts/smoke-helper-communication.mjs",
    "test:helper:mock": "npm run build && node scripts/smoke-helper-mock.mjs",
    "test:runtime": "node scripts/run-node-tests.mjs test/deepseekRuntime.node.ts test/codexMcpConfig.test.ts test/windowsExecutablePaths.test.ts test/helperServerSecurity.test.ts test/diagnosticPrivacy.test.ts test/markdownSecurity.test.ts",
    "diagnose:codex-latency": "npm run build && node scripts/diagnose-codex-latency.mjs",
    "test:evidence": "npm run build && node scripts/smoke-evidence-contract.mjs && node scripts/smoke-evidence-golden.mjs && node scripts/smoke-pdf-visual-audit.mjs",
    "test:evidence:ci": "node scripts/smoke-evidence-contract.mjs && node scripts/smoke-evidence-golden.mjs && node scripts/smoke-pdf-visual-audit.mjs",
    "eval:pdf:golden": "node scripts/eval-real-pdf-golden.mjs",
    "eval:pdf:review": "node scripts/build-pdf-review-site.mjs",
    "eval:pdf:visual": "node scripts/build-pdf-visual-audit-pack.mjs",
    "eval:pdf:review:serve": "python3 -m http.server 4177 --bind 127.0.0.1 --directory .claudero-eval/review-site",
    "trace:academic": "node scripts/replay-academic-trace.mjs",
    "trace:replay": "node scripts/replay-agent-trace.mjs",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "zotero-plugin test",
    "update-deps": "npm update --save"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.237",
    "@iconify-json/lucide": "^1.2.124",
    "@iconify-json/tabler": "^1.2.38",
    "@vscode/markdown-it-katex": "^1.1.2",
    "highlight.js": "^11.12.0",
    "iconify-icon": "^3.0.2",
    "katex": "0.18.4",
    "markdown-it": "^15.0.0",
    "zod": "^4.0.0",
    "zotero-plugin-toolkit": "^5.2.0"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.0",
    "@zotero-plugin/eslint-config": "^0.6.10",
    "chai": "^6.2.2",
    "eslint": "^9.39.2",
    "mocha": "^11.7.5",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "^0.8.2",
    "zotero-types": "^4.1.3"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "diff": "8.0.4",
    "serialize-javascript": "7.0.5"
  }
}
