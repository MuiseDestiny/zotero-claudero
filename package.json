{
  "name": "claudero",
  "type": "module",
  "version": "0.1.0",
  "description": "Claude Code assistant embedded in Zotero",
  "config": {
    "addonName": "Claudero",
    "addonID": "claudero@muisedestiny.com",
    "addonRef": "claudero",
    "addonInstance": "Claudero",
    "prefsPrefix": "extensions.zotero.claudero"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muisedestiny/claudero.git"
  },
  "author": "muisedestiny",
  "bugs": {
    "url": "https://github.com/muisedestiny/claudero/issues"
  },
  "homepage": "https://github.com/muisedestiny/claudero#readme",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "restart": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "test:helper": "npm run build && node scripts/smoke-helper-communication.mjs --full",
    "test:helper:quick": "npm run build && node scripts/smoke-helper-communication.mjs",
    "test:evidence": "npm run build && node scripts/smoke-evidence-contract.mjs && node scripts/smoke-evidence-golden.mjs && node scripts/smoke-pdf-visual-audit.mjs",
    "eval:pdf:golden": "node scripts/eval-real-pdf-golden.mjs",
    "eval:pdf:review": "node scripts/build-pdf-review-site.mjs",
    "eval:pdf:visual": "node scripts/build-pdf-visual-audit-pack.mjs",
    "eval:pdf:review:serve": "python3 -m http.server 4177 --bind 127.0.0.1 --directory .claudero-eval/review-site",
    "trace:replay": "node scripts/replay-agent-trace.mjs",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "zotero-plugin test",
    "update-deps": "npm update --save"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.186",
    "@iconify-json/lucide": "^1.2.114",
    "@iconify-json/tabler": "^1.2.35",
    "highlight.js": "^11.11.1",
    "iconify-icon": "^3.0.2",
    "katex": "0.16.25",
    "markdown-it": "^14.2.0",
    "markdown-it-katex": "^2.0.3",
    "zod": "^4.0.0",
    "zotero-plugin-toolkit": "^5.1.0-beta.13"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/markdown-it": "^14.1.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.0",
    "@zotero-plugin/eslint-config": "^0.6.7",
    "chai": "^6.2.1",
    "eslint": "^9.39.2",
    "mocha": "^11.7.5",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "^0.8.2",
    "zotero-types": "^4.1.0-beta.4"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  },
  "overrides": {
    "markdown-it-katex": {
      "katex": "0.16.25"
    }
  }
}
